{
  "name": "studio-sdk-code-assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w server",
    "fetch-sdk": "npm run fetch-sdk -w server",
    "ingest": "npm run ingest -w server",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "start": "npm start -w server",
    "eval": "npm run eval -w server",
    "eval:e2e": "npm run eval:e2e -w server",
    "eval:hybrid": "npm run eval:hybrid -w server"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}

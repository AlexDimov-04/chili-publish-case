# OpenAI API key (embeddings + code generation). Required.
OPENAI_API_KEY=
# Embedding model; default is set in server/src/config.ts
EMBEDDING_MODEL=text-embedding-3-small
# Chat model for code generation; default is set in server/src/config.ts
CHAT_MODEL=
# Port for the API server (the web dev server proxies /api to it)
PORT=3001
